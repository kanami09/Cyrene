{
    "version": "2.3.1r",
    "description": "为全局系统标题栏添加自定义效果，支持Windows 10和Windows 11。",
    "homepage": "https://github.com/Maplespe/DWMBlurGlass",
    "license": "LGPL-3.0-or-later | GPL-3.0-or-later",
    "notes": "由于 DWM 运行在沙箱中，程序不能位于用户目录（%USERPROFILE%）下，否则会拒绝启动。若 Scoop 安装在用户目录下，请使用全局安装（scoop install -g）。",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Maplespe/DWMBlurGlass/releases/download/2.3.1r/DWMBlurGlass_2.3.1_x64.zip",
            "hash": "cfda271d28f0fd9bda4978bd8bd793e31957632c5ca442441de9701c47f6707e"
        }
    },
    "extract_dir": "Release",
    "pre_install": "if (!(Test-Path \"$dir/data/config.ini\")) { New-Item \"$dir/data/config.ini\" -ItemType File | Out-Null }",
    "pre_uninstall": [
        "if ($cmd -eq 'uninstall') {",
        "    $appRoot = (Split-Path $dir) + '\\'",
        "    $task = Get-ScheduledTask -TaskName 'DWMBlurGlass_Extend' -ErrorAction SilentlyContinue",
        "    if ($task.Actions.Execute | Where-Object { $_ -and $_.Trim('\"').StartsWith($appRoot, [System.StringComparison]::OrdinalIgnoreCase) }) {",
        "        error '计划任务 DWMBlurGlass_Extend 仍指向本程序，请先在 DWMBlurGlass 中点击“卸载”，再执行卸载。'",
        "        exit 1",
        "    }",
        "}"
    ],
    "shortcuts": [
        [
            "DWMBlurGlassGUI.exe",
            "DWMBlurGlassGUI"
        ]
    ],
    "persist": [
        "data/config.ini",
        "data/symbols"
    ],
    "checkver": {
        "github": "https://github.com/Maplespe/DWMBlurGlass",
        "regex": "releases/tag/([\\d.]+r?)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Maplespe/DWMBlurGlass/releases/download/$version/DWMBlurGlass_$matchHead_x64.zip"
            }
        }
    }
}
