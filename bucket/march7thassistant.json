{
    "version": "2026.11.8",
    "description": "《崩坏：星穹铁道》开源自动化助手，支持日常任务、账号管理、抽卡记录和云游戏。",
    "homepage": "https://github.com/moesnow/March7thAssistant",
    "license": "GPL-3.0-only",
    "notes": [
        "默认关闭应用内的更新检查，使用 scoop update march7thassistant 升级，请勿使用应用内更新。",
        "卸载前请关闭助手及其云游戏浏览器。全局安装的外部数据清理仅针对执行卸载的用户。"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/moesnow/March7thAssistant/releases/download/v2026.11.8/March7thAssistant_full.7z",
            "hash": "d5010869e4fc2d91054cb88848cf0710c3ce8e42d0f329d0f62e4764500f1dcc",
            "extract_dir": "March7thAssistant_full"
        }
    },
    "##": "Root configuration files are snapshotted by hooks because upstream atomic writes replace file hardlinks.",
    "pre_install": [
        "$ErrorActionPreference = 'Stop'",
        "$state = Join-Path $persist_dir 'state'",
        "$files = @('config.yaml', 'config.yaml.prefallback', 'warp.json', '3rdparty/Auto_Simulated_Universe/info.yml', '3rdparty/Auto_Simulated_Universe/info_old.yml', '3rdparty/Fhoe-Rail/config.json')",
        "if (Test-Path -LiteralPath $state) {",
        "    $files += @(Get-ChildItem -LiteralPath $state -Filter 'config.yaml.bak*' -File | Select-Object -ExpandProperty Name)",
        "    foreach ($file in $files) {",
        "        $source = Join-Path $state $file",
        "        if (Test-Path -LiteralPath $source -PathType Leaf) {",
        "            $target = Join-Path $dir $file",
        "            New-Item -ItemType Directory -Path (Split-Path $target) -Force | Out-Null",
        "            Copy-Item -LiteralPath $source -Destination $target -Force",
        "        }",
        "    }",
        "}",
        "$config = Join-Path $dir 'config.yaml'",
        "if (!(Test-Path -LiteralPath $config)) { Copy-Item -LiteralPath \"$dir/assets/config/config.example.yaml\" -Destination $config }",
        "$raw = [System.IO.File]::ReadAllText($config)",
        "if ($raw -match '(?m)^check_update[ \\t]*:') {",
        "    $raw = $raw -replace '(?m)^check_update[ \\t]*:[^\\r\\n]*', 'check_update: false'",
        "} else {",
        "    $raw = $raw.TrimEnd([char[]]\"`r`n\") + \"`r`ncheck_update: false`r`n\"",
        "}",
        "[System.IO.File]::WriteAllText($config, $raw, (New-Object System.Text.UTF8Encoding $false))",
        "New-Item -ItemType Directory -Path \"$dir/3rdparty/WebBrowser\", $persist_dir -Force | Out-Null",
        "if (!(Test-Path -LiteralPath \"$env:ProgramData/March7thAssistant/disclaimer\")) {",
        "    [System.IO.File]::WriteAllText(\"$persist_dir/disclaimer-owned\", '')",
        "}"
    ],
    "pre_uninstall": [
        "$ErrorActionPreference = 'Stop'",
        "$app_root = [System.IO.Path]::GetFullPath((Split-Path $dir)).TrimEnd('\\') + '\\'",
        "function Test-March7thPath($path) {",
        "    if (!$path) { return $false }",
        "    $path = [Environment]::ExpandEnvironmentVariables($path.Trim('\"'))",
        "    if (![System.IO.Path]::IsPathRooted($path)) { return $false }",
        "    return [System.IO.Path]::GetFullPath($path).StartsWith($app_root, [System.StringComparison]::OrdinalIgnoreCase)",
        "}",
        "$browser_profile = [System.IO.Path]::GetFullPath(\"$persist_dir/3rdparty/WebBrowser/UserProfile\")",
        "$processes = @(Get-CimInstance Win32_Process | Where-Object {",
        "    (Test-March7thPath $_.ExecutablePath) -or",
        "    (!$_.ExecutablePath -and $_.Name -in @('March7th Launcher.exe', 'March7th Assistant.exe', 'March7th Updater.exe', 'm7a.exe')) -or",
        "    ($_.CommandLine -and $_.CommandLine.Contains('--march-7th-assistant-sr-cloud-game') -and",
        "        ($_.CommandLine.IndexOf($app_root, [System.StringComparison]::OrdinalIgnoreCase) -ge 0 -or $_.CommandLine.IndexOf($browser_profile, [System.StringComparison]::OrdinalIgnoreCase) -ge 0))",
        "})",
        "if ($processes) { throw '请先关闭三月七小助手及其任务、更新器和云游戏浏览器，再重试更新或卸载。' }",
        "$state = Join-Path $persist_dir 'state'",
        "New-Item -ItemType Directory -Path $state -Force | Out-Null",
        "$files = @('config.yaml', 'config.yaml.prefallback', 'warp.json', '3rdparty/Auto_Simulated_Universe/info.yml', '3rdparty/Auto_Simulated_Universe/info_old.yml', '3rdparty/Fhoe-Rail/config.json')",
        "$files += @(Get-ChildItem -LiteralPath $dir -Filter 'config.yaml.bak*' -File | Select-Object -ExpandProperty Name)",
        "$files += @(Get-ChildItem -LiteralPath $state -Filter 'config.yaml.bak*' -File | Select-Object -ExpandProperty Name)",
        "$files = @($files | Select-Object -Unique)",
        "foreach ($file in $files) {",
        "    $source = Join-Path $dir $file",
        "    $target = Join-Path $state $file",
        "    if (Test-Path -LiteralPath $source -PathType Leaf) {",
        "        New-Item -ItemType Directory -Path (Split-Path $target) -Force | Out-Null",
        "        Copy-Item -LiteralPath $source -Destination \"$target.scoop-tmp\" -Force",
        "        Move-Item -LiteralPath \"$target.scoop-tmp\" -Destination $target -Force",
        "    }",
        "}",
        "foreach ($file in $files) {",
        "    $target = Join-Path $state $file",
        "    if (!(Test-Path -LiteralPath (Join-Path $dir $file) -PathType Leaf) -and (Test-Path -LiteralPath $target -PathType Leaf)) {",
        "        Remove-Item -LiteralPath $target -Force",
        "    }",
        "}",
        "if (!(Get-Command Get-ScheduledTask -ErrorAction SilentlyContinue)) { Import-Module \"$env:WINDIR/System32/WindowsPowerShell/v1.0/Modules/ScheduledTasks/ScheduledTasks.psd1\" }",
        "$tasks = @(Get-ScheduledTask | Where-Object { $_.TaskPath -eq '\\' -and $_.TaskName -in @('StartMarch7thAssistant', 'March7thAssistantAutostart') })",
        "foreach ($task in $tasks) {",
        "    $actions = @($task.Actions)",
        "    if (!$actions.Count -or @($actions | Where-Object { !(Test-March7thPath $_.Execute) }).Count) { continue }",
        "    if ($cmd -eq 'uninstall') {",
        "        Unregister-ScheduledTask -InputObject $task -Confirm:$false | Out-Null",
        "    } else {",
        "        foreach ($action in $actions) {",
        "            foreach ($property in @('Execute', 'WorkingDirectory')) {",
        "                if (Test-March7thPath $action.$property) {",
        "                    $relative = [System.IO.Path]::GetFullPath([Environment]::ExpandEnvironmentVariables($action.$property.Trim('\"'))).Substring($app_root.Length)",
        "                    $separator = $relative.IndexOf('\\')",
        "                    $suffix = if ($separator -ge 0) { $relative.Substring($separator) } else { '' }",
        "                    $action.$property = $app_root + 'current' + $suffix",
        "                }",
        "            }",
        "        }",
        "        Set-ScheduledTask -InputObject $task | Out-Null",
        "    }",
        "}",
        "$registry_path = Join-Path $env:LOCALAPPDATA 'March7thAssistant/installs.json'",
        "$can_clean_disclaimer = !$global",
        "if (Test-Path -LiteralPath $registry_path) {",
        "    try {",
        "        $original = [System.IO.File]::ReadAllText($registry_path)",
        "        $registry = $original | ConvertFrom-Json",
        "        if ($registry.schema -ne 1 -or $null -eq $registry.installs -or $registry.installs -isnot [Array]) { throw '未知的安装登记格式' }",
        "        foreach ($entry in $registry.installs) {",
        "            if ($entry.path -isnot [string] -or ![System.IO.Path]::IsPathRooted($entry.path)) { throw '无效的安装登记路径' }",
        "        }",
        "        $others = @($registry.installs | Where-Object { !(Test-March7thPath $_.path) })",
        "        $can_clean_disclaimer = $can_clean_disclaimer -and !$others.Count",
        "        if ($others.Count -ne $registry.installs.Count -or ($cmd -eq 'uninstall' -and $purge -and !$others.Count)) {",
        "            if ([System.IO.File]::ReadAllText($registry_path) -cne $original) { throw '安装登记已被其他进程修改' }",
        "            if ($cmd -eq 'uninstall' -and $purge -and !$others.Count) {",
        "                Remove-Item -LiteralPath $registry_path -Force",
        "                if (!(Get-ChildItem -LiteralPath (Split-Path $registry_path) -Force)) { [System.IO.Directory]::Delete((Split-Path $registry_path)) }",
        "            } else {",
        "                $registry.installs = $others",
        "                $temporary = $registry_path + '.scoop-' + [guid]::NewGuid().ToString('N') + '.tmp'",
        "                try {",
        "                    [System.IO.File]::WriteAllText($temporary, ($registry | ConvertTo-Json -Depth 20), (New-Object System.Text.UTF8Encoding $false))",
        "                    Move-Item -LiteralPath $temporary -Destination $registry_path -Force",
        "                } finally {",
        "                    if (Test-Path -LiteralPath $temporary) { Remove-Item -LiteralPath $temporary -Force }",
        "                }",
        "            }",
        "        }",
        "    } catch {",
        "        $can_clean_disclaimer = $false",
        "        warn \"无法清理 $registry_path，已保留外部数据：$($_.Exception.Message)\"",
        "    }",
        "}",
        "if ($cmd -eq 'uninstall' -and $purge) {",
        "    $disclaimer = Join-Path $env:ProgramData 'March7thAssistant/disclaimer'",
        "    if ($can_clean_disclaimer -and (Test-Path -LiteralPath \"$persist_dir/disclaimer-owned\")) {",
        "        try {",
        "            if (Test-Path -LiteralPath $disclaimer -PathType Leaf) { Remove-Item -LiteralPath $disclaimer -Force }",
        "            $parent = Split-Path $disclaimer",
        "            if ((Test-Path -LiteralPath $parent -PathType Container) -and !(Get-ChildItem -LiteralPath $parent -Force)) { [System.IO.Directory]::Delete($parent) }",
        "        } catch { warn \"无法清理 $disclaimer，请使用有权限的终端手动清理：$($_.Exception.Message)\" }",
        "    } elseif (Test-Path -LiteralPath $disclaimer) {",
        "        warn \"已保留共享的首次使用标记 $disclaimer：无法确认它仅属于本安装。\"",
        "    }",
        "}"
    ],
    "bin": "m7a.exe",
    "shortcuts": [
        [
            "March7th Launcher.exe",
            "三月七小助手"
        ]
    ],
    "persist": [
        "config",
        "settings",
        "logs",
        "screenshots",
        "3rdparty/WebBrowser/UserProfile"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/moesnow/March7thAssistant/releases/download/v$version/March7thAssistant_full.7z"
            }
        }
    }
}
