{
    "version": "5.2.3",
    "description": "Gitea Actions 的官方 Runner。",
    "homepage": "https://gitea.com/gitea/runner",
    "license": "MIT",
    "notes": [
        "注册文件 .runner 默认保存在执行命令时的工作目录中，请在固定目录下运行 register 和 daemon。",
        "可通过 'gitea-runner config init' 生成 config.yaml，并使用 'gitea-runner -c config.yaml daemon' 启动。"
    ],
    "architecture": {
        "64bit": {
            "url": "https://gitea.com/gitea/runner/releases/download/v5.2.3/gitea-runner-5.2.3-windows-amd64.exe#/gitea-runner.exe",
            "hash": "92c005e78c47ff12aea3419e3b2ba0b883c604152419be7cc7b4ef006091ff28"
        }
    },
    "bin": "gitea-runner.exe",
    "post_uninstall": [
        "if ($cmd -eq 'uninstall') {",
        "    $leftover = @('actcache', 'act') | ForEach-Object { Join-Path $env:USERPROFILE \".cache\\$_\" } | Where-Object { Test-Path -LiteralPath $_ }",
        "    if ($leftover) { warn \"以下缓存目录可能与 nektos/act 共用，未自动删除，如不再需要请手动清理：$($leftover -join '、')\" }",
        "    warn '注册文件 .runner 和 config.yaml 位于运行 register 时的工作目录中，未自动删除，如不再需要请手动清理。'",
        "}"
    ],
    "checkver": {
        "url": "https://gitea.com/api/v1/repos/gitea/runner/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://gitea.com/gitea/runner/releases/download/v$version/gitea-runner-$version-windows-amd64.exe#/gitea-runner.exe"
            }
        },
        "hash": {
            "url": "$baseurl/checksums.txt",
            "regex": "$sha256\\s+$basename"
        }
    }
}
