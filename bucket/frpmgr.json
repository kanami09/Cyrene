{
    "version": "1.27.2",
    "description": "Windows 平台的 FRP GUI客户端。",
    "homepage": "https://github.com/koho/frpmgr",
    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/koho/frpmgr/releases/download/v1.27.2/frpmgr-1.27.2-x64.zip",
            "hash": "a95a8637ae25398d90e5b993058d046164ba40a547bb5aafc088ea6c081632df"
        },
        "32bit": {
            "url": "https://github.com/koho/frpmgr/releases/download/v1.27.2/frpmgr-1.27.2-x86.zip",
            "hash": "cfb1c26fe6b2cd034c75b5d270c52fe82f512589a8c8be28fd78b339b2e6cd68"
        },
        "arm64": {
            "url": "https://github.com/koho/frpmgr/releases/download/v1.27.2/frpmgr-1.27.2-arm64.zip",
            "hash": "c99a873b28b2f4ee20d6cbf8c0b87f686eab8f9e3303db86541d81b147b5ce8f"
        }
    },
    "pre_install": [
        "$cfg = if (Test-Path \"$persist_dir/app.json\") { \"$persist_dir/app.json\" } else { \"$dir/app.json\" }",
        "$raw = if (Test-Path $cfg) { Get-Content $cfg -Raw } else { '' }",
        "$json = if ($raw -and $raw.Trim()) { $raw | ConvertFrom-Json } else { [PSCustomObject]@{} }",
        "$json | Add-Member -MemberType NoteProperty -Name 'checkUpdate' -Value $false -Force",
        "[System.IO.File]::WriteAllText($cfg, ($json | ConvertTo-Json -Depth 10), (New-Object System.Text.UTF8Encoding $false))"
    ],
    "pre_uninstall": [
        "if ($cmd -eq 'uninstall') {",
        "    $appRoot = (Split-Path $dir) + '\\'",
        "    $services = @(Get-CimInstance Win32_Service -ErrorAction SilentlyContinue | Where-Object { $_.PathName -and $_.PathName.TrimStart('\"').StartsWith($appRoot, [System.StringComparison]::OrdinalIgnoreCase) })",
        "    if ($services) {",
        "        error \"以下服务仍在使用 FRP 管理器：$($services.DisplayName -join '、')\"",
        "        error '请先在 FRP 管理器中停止这些配置（停止时会自动删除对应服务），再执行卸载。'",
        "        exit 1",
        "    }",
        "}"
    ],
    "shortcuts": [
        [
            "frpmgr.exe",
            "FRP管理器"
        ]
    ],
    "persist": [
        "logs",
        "profiles",
        "stores",
        "app.json"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/koho/frpmgr/releases/download/v$version/frpmgr-$version-x64.zip"
            },
            "32bit": {
                "url": "https://github.com/koho/frpmgr/releases/download/v$version/frpmgr-$version-x86.zip"
            },
            "arm64": {
                "url": "https://github.com/koho/frpmgr/releases/download/v$version/frpmgr-$version-arm64.zip"
            }
        }
    }
}
