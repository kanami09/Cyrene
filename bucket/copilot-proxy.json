{
    "version": "0.2.3",
    "description": "重定向GitHub Copilot的流量到自定义URL。",
    "homepage": "https://github.com/kanami09/Copilot-Proxy",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/kanami09/Copilot-Proxy/releases/download/v0.2.3/CopilotProxy-v0.2.3-windows-x64.zip",
            "hash": "75d41356a8b3535edac27eba6101348987899e8e0f02279db055c5f73fa01443"
        }
    },
    "pre_install": "if (!(Test-Path \"$persist_dir/config.toml\")) { Copy-Item \"$dir/config.template.toml\" \"$dir/config.toml\" }",
    "post_uninstall": [
        "if ($cmd -eq 'uninstall') {",
        "    $mitm = Join-Path $env:USERPROFILE '.mitmproxy'",
        "    if (Test-Path -LiteralPath $mitm) {",
        "        warn \"mitmproxy 的 CA 证书目录 $mitm 可能与独立安装的 mitmproxy 共用，未自动删除。\"",
        "        warn '如不再需要，请手动删除该目录，并在证书管理器（certmgr.msc）中移除已信任的 mitmproxy 根证书。'",
        "    }",
        "}"
    ],
    "bin": "CopilotProxy.exe",
    "persist": [
        "logs",
        "config.toml"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/kanami09/Copilot-Proxy/releases/download/v$version/CopilotProxy-v$version-windows-x64.zip"
            }
        }
    }
}
